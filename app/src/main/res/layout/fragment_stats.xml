                    <TextView android:id="@+id/tv_day_5" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@drawable/bg_category_pill" android:gravity="center" android:text="5" android:textColor="@color/habit_primary" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_day_6" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@drawable/bg_category_pill" android:gravity="center" android:text="6" android:textColor="@color/habit_primary" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_day_7" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@drawable/bg_category_pill" android:gravity="center" android:text="7" android:textColor="@color/habit_primary" android:textStyle="bold" />
                </LinearLayout>
