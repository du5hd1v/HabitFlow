                    <TextView android:id="@+id/tv_day_9" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@drawable/bg_category_pill" android:gravity="center" android:text="9" android:textColor="@color/habit_primary" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_day_10" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@drawable/bg_category_pill" android:gravity="center" android:text="10" android:textColor="@color/habit_primary" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_day_11" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@drawable/bg_category_pill" android:gravity="center" android:text="11" android:textColor="@color/habit_primary" android:textStyle="bold" />
                    <TextView android:id="@+id/tv_day_12" android:layout_width="32dp" android:layout_height="32dp" android:layout_margin="4dp" android:background="@color/habit_primary" android:gravity="center" android:text="12" android:textColor="@color/white" android:textStyle="bold" />
                </LinearLayout>-->

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
