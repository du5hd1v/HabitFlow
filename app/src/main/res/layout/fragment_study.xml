<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/habit_bg_light"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:orientation="vertical">

        <!-- Focus Header & Active Task -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DEEP FOCUS POMODORO"
            android:textColor="@color/habit_primary"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- Circular / Card Timer Display -->
        <TextView
            android:id="@+id/tv_active_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Deep Focus Session"
            android:textColor="@color/habit_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="@color/habit_surface_light"
            app:cardCornerRadius="24dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp">

                <TextView
                    android:id="@+id/tv_timer_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="25:00"
                    android:textColor="@color/habit_primary"
                    android:textSize="56sp"
                    android:textStyle="bold"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/tv_timer_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="MINUTES LEFT"
                    android:textColor="@color/habit_text_secondary_dark"
                    android:textSize="14sp"
                    android:maxLines="1" />

                <!-- Timer Controls -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_timer_start"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        android:text="Start"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="4dp"
                        app:cornerRadius="16dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_timer_pause"
                        style="?attr/materialButtonOutlinedStyle"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:maxLines="1"
                        android:paddingHorizontal="4dp"
                        android:text="Pause"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        app:cornerRadius="16dp"
                        app:strokeColor="@color/habit_text_secondary_dark" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_timer_reset"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        android:text="Reset"
                        android:textColor="@android:color/black"
                        android:textSize="14sp"
                        android:maxLines="1"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:paddingHorizontal="4dp"
                        style="?attr/materialButtonOutlinedStyle"
                        app:strokeColor="@color/habit_text_secondary_dark"
                        app:cornerRadius="16dp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Focus Duration Selector -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Focus Duration Presets"
            android:textColor="@color/habit_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_duration_15"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="15m"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingHorizontal="12dp"
                    app:backgroundTint="@color/habit_surface_light"
                    android:textColor="@android:color/black"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_duration_25"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="25m"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingHorizontal="12dp"
                    app:backgroundTint="@color/habit_surface_light"
                    android:textColor="@android:color/black"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_duration_30"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:maxLines="1"
                    android:paddingHorizontal="12dp"
                    android:text="30m"
                    android:textColor="@android:color/black"
                    android:textSize="14sp"
                    app:backgroundTint="@color/habit_surface_light"
                    app:cornerRadius="12dp"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_duration_45"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="45m"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingHorizontal="12dp"
                    app:backgroundTint="@color/habit_surface_light"
                    android:textColor="@android:color/black"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_duration_60"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="60m"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingHorizontal="12dp"
                    app:backgroundTint="@color/habit_surface_light"
                    android:textColor="@android:color/black"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_duration_custom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Custom"
                    android:textSize="14sp"
                    android:maxLines="1"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:paddingHorizontal="12dp"
                    app:backgroundTint="@color/habit_surface_light"
                    android:textColor="@android:color/black"
                    app:strokeColor="#334155"
                    app:strokeWidth="1dp"
                    app:cornerRadius="12dp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Focus Environment Selector (Ambient Audio Presets) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Focus Environment (Ambient Audio)"
            android:textColor="@color/habit_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_audio_rain"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:text="Rain"
                android:textSize="13sp"
                android:maxLines="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="4dp"
                app:backgroundTint="@color/habit_surface_light"
                android:textColor="@android:color/black"
                app:strokeColor="#334155"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_audio_lofi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:layout_weight="1"
                android:text="Lo-Fi Beats"
                android:textSize="13sp"
                android:maxLines="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="4dp"
                app:backgroundTint="@color/habit_surface_light"
                android:textColor="@android:color/black"
                app:strokeColor="#334155"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_audio_cafe"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="Cafe"
                android:textSize="13sp"
                android:maxLines="1"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:paddingHorizontal="4dp"
                app:backgroundTint="@color/habit_surface_light"
                android:textColor="@android:color/black"
                app:strokeColor="#334155"
                app:strokeWidth="1dp"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <!-- Reward Banner -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            app:cardBackgroundColor="#FEF3C7"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/ic_ai"
                    android:contentDescription="Reward Icon" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Session Reward"
                        android:textColor="@color/habit_accent_gold_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:maxLines="1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+100 XP &amp; Streak Shield Protection"
                        android:textColor="@color/habit_text_primary_light"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:maxLines="2"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
