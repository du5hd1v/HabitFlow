<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/habit_bg_light"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AI STUDY &amp; HABIT PLANNER"
            android:textColor="@color/habit_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Intelligent Learning Roadmap"
            android:textColor="@color/habit_text_primary_light"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Prompt Input Text Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxBackgroundMode="outline"
            app:boxCornerRadiusBottomEnd="16dp"
            app:boxCornerRadiusBottomStart="16dp"
            app:boxCornerRadiusTopEnd="16dp"
            app:boxCornerRadiusTopStart="16dp"
            android:hint="How do I study for my upcoming SE4041 MADD assignment?">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_ai_prompt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:minLines="3"
                android:text="How do I study for my upcoming SE4041 MADD assignment?" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Generate Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_generate_steps"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="Generate Study Steps"
            android:textSize="16sp"
            app:cornerRadius="16dp" />

        <!-- Progress Loading Indicator -->
        <ProgressBar
            android:id="@+id/progress_ai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- Suggested Roadmap View Header & Add All Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Suggested Roadmap"
                android:textColor="@color/habit_text_primary_light"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_add_all_steps"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Add All to Tasks"
                android:textSize="12sp"
                app:cornerRadius="8dp" />
        </LinearLayout>

        <!-- RecyclerView for generated roadmap steps -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_ai_steps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
