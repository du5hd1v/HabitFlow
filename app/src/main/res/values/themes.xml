<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.HabitFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/habit_primary</item>
        <item name="colorPrimaryVariant">@color/habit_primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/habit_accent_gold</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Background & Surface -->
        <item name="android:windowBackground">@color/habit_bg_light</item>
        <item name="colorSurface">@color/habit_surface_light</item>
        <item name="colorOnSurface">@color/habit_text_primary_light</item>

        <!-- Status bar and navigation bar -->
        <item name="android:statusBarColor">@color/habit_bg_light</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>
</resources>
